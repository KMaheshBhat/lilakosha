### TASK
Analyze the provided multi-turn chat history. Synthesize the roles, names, and profiles for both the human player (USER) and the AI character (Bot).

### CHAT EVIDENCE
{% set source = session.meta.source or {} %}
{% set bot_name = source.get("bot_name") or "the character" %}

{% for item in session.items if item.kind == 'turn' -%}
    {% if loop.index0 < 100 -%}
        {%- set role = "USER" if item.actor_id == "user" else bot_name -%}
        {%- set variant = (item.content | selectattr("name", "equalto", "original") | first) or (item.content | first) -%}
        {%- if variant and variant.text -%}
{{ role }}: {{ variant.text }}
        {%- endif -%}
    {% endif %}
{%- endfor %}
